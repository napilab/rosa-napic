set -x
env
ls -la ${SRCDIR}
mkdir -p ${BUILDROOT}/etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/napi-mac.service \
    ${BUILDROOT}/etc/systemd/system/multi-user.target.wants/napi-mac.service
